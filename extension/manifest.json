{
  "manifest_version": 3,
  "name": "JREAD — Local captions",
  "version": "0.1.0",
  "description": "Apply local subtitle tracks and translate Japanese tab audio with your paired JREAD companion.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "tabCapture",
    "offscreen",
    "storage",
    "nativeMessaging",
    "webNavigation"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "JREAD captions",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "dist/worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:8765 ws://127.0.0.1:8765"
  },
  "key": ""
}
